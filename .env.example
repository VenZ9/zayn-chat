# Server-side only. Never prefix these with NEXT_PUBLIC_ - that would expose
# them to the browser.
#
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any OpenRouter model id, e.g.
#   openai/gpt-4o-mini
#   anthropic/claude-3.5-sonnet
#   google/gemini-flash-1.5
# Browse the full list at https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: shown to OpenRouter on the dashboard / leaderboard.
# OPENROUTER_SITE_URL=
# OPENROUTER_APP_NAME=Zayn Chat
